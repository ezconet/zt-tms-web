@using Zenatur.Tms.Application.Motoristas
@inject IMotoristaManagementService Service
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(IsEdicao ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" />
            <MudText Typo="Typo.h6">@(IsEdicao ? "Editar Motorista" : "Novo Motorista")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_form.Cpf" Label="CPF" Variant="Variant.Outlined"
                              Disabled="IsEdicao" Required="true" Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_form.Nome" Label="Nome Completo" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_dataNasc" Label="Data de Nascimento" Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy" MaxDate="DateTime.Today" Required="true" />
            </MudItem>
            <MudItem xs="6" md="2">
                <MudTextField @bind-Value="_form.TelefoneDdd" Label="DDD" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudTextField @bind-Value="_form.TelefoneNumero" Label="Telefone" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_form.Email" Label="E-mail" Variant="Variant.Outlined" InputType="InputType.Email" />
            </MudItem>
            <MudItem xs="12"><MudDivider Class="my-2" />
                <MudText Typo="Typo.overline" Style="color:#6B7280;font-size:10px;letter-spacing:1px;">RNTRC + CNH</MudText>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_form.Rntrc" Label="RNTRC" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="_form.RntrcSituacao" Label="Situação RNTRC" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Ativo")">Ativo</MudSelectItem>
                    <MudSelectItem Value="@("Inativo")">Inativo</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_form.CnhNumero" Label="CNH Número" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_form.CnhCategoria" Label="CNH Categoria" Variant="Variant.Outlined" />
            </MudItem>
            @if (_erro is not null)
            {
                <MudItem xs="12"><MudAlert Severity="Severity.Error" Dense="true">@_erro</MudAlert></MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Salvar" Disabled="_salvando">@(IsEdicao ? "Atualizar" : "Cadastrar")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public MotoristaListItem? Original { get; set; }

    private bool IsEdicao => Original is not null;
    private MotoristaListItem _form = new();
    private DateTime? _dataNasc;
    private string? _erro;
    private bool _salvando;

    protected override void OnInitialized()
    {
        if (Original is not null)
        {
            _form = Original.Clone();
            if (_form.DataNascimento is DateOnly d) _dataNasc = d.ToDateTime(TimeOnly.MinValue);
        }
        else { _form = new MotoristaListItem { RntrcSituacao = "Ativo" }; }
    }

    private async Task Salvar()
    {
        _erro = null;
        var cpf = new string(_form.Cpf.Where(char.IsDigit).ToArray());
        if (cpf.Length != 11) { _erro = "CPF deve ter 11 dígitos."; return; }
        if (string.IsNullOrWhiteSpace(_form.Nome)) { _erro = "Nome obrigatório."; return; }
        if (string.IsNullOrWhiteSpace(_form.TelefoneDdd) || string.IsNullOrWhiteSpace(_form.TelefoneNumero))
        { _erro = "Telefone obrigatório."; return; }
        if (_dataNasc is null) { _erro = "Data de nascimento obrigatória."; return; }

        _form.Cpf = cpf;
        _form.DataNascimento = DateOnly.FromDateTime(_dataNasc.Value);
        _salvando = true;
        try
        {
            await Service.SalvarAsync(_form);
            Snackbar.Add($"Motorista {(IsEdicao ? "atualizado" : "cadastrado")}.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_form));
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }

    private void Cancelar() => MudDialog.Cancel();
}
