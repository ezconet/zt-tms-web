    // Monta lista favorecidos do InsertTrip. PF puro → 1 favorecido.
    // PJ → favorecido1 (CNPJ titular) com responsável-consumo = motorista (spec 05).
    private List<FavorecidoItem> MontarFavorecidos(int docTipo, int? enderecoIbge, int? enderecoNum)
    {
        var titular = new FavorecidoItem
        {
            // Tabela 15 TipoFavorecido: 1=CONTRATADO (favorecido pago no CIOT),
            // 2=SUB CONTRATANTE, 3=MOTORISTA. NÃO é tipo de documento.
            Tipo = 1,
            Nome = _vm.FavorecidoNome ?? string.Empty,
            Documentos =
            [
                new DocumentoFavorecidoItem { Tipo = docTipo, Numero = _vm.FavorecidoDocumento ?? string.Empty }
            ],
            DataNascimento     = _favorecido!.DataNascimento ?? default,
            TelefoneDdd        = _favorecido.TelefoneDdd,
            TelefoneNumero     = _favorecido.TelefoneNumero,
            EnderecoIbge       = enderecoIbge,
            EnderecoLogradouro = _favorecido.EnderecoLogradouro,
            EnderecoNumero     = enderecoNum,
            EnderecoBairro     = _favorecido.EnderecoBairro,
            EnderecoUf         = _favorecido.EnderecoUf,
            EnderecoCep        = _favorecido.EnderecoCep,
        };

        // Método de pagamento do favorecido (Pamcard exige conta OU Pix OU cartão)
        titular = AplicarMeioPagamento(titular);

        // Favorecido PJ (CNPJ, docTipo=1 Pamcard) → vincula condutor PF responsável pelo consumo
        if (_vm.FavorecidoDocumento?.Length == 14 &&
            !string.IsNullOrWhiteSpace(_vm.MotoristaCpf))
        {
            titular = titular with
            {
                ConsumoResponsavelCpf  = new string(_vm.MotoristaCpf.Where(char.IsDigit).ToArray()),
                ConsumoResponsavelNome = _vm.MotoristaNome,
            };
        }

        return [titular];
    }

    // Pamcard Tabela 42 chave Pix: 1=CPF/CNPJ 2=E-mail 3=Celular 4=Aleatória
    private static int? MapPixTipo(string? t) => t?.ToUpperInvariant() switch
    {
        "CPF" or "CNPJ" => 1,
        "EMAIL"         => 2,
        "CELULAR"       => 3,
        "ALEATORIA"     => 4,
        _               => null,
    };

    private FavorecidoItem AplicarMeioPagamento(FavorecidoItem fav)
    {
        var id = _vm.MeioPagamento;
        if (string.IsNullOrWhiteSpace(id)) return fav;

        // Meio do cadastro local ("local-{i}") → preenche conta/Pix
        if (id.StartsWith("local-", StringComparison.Ordinal) &&
            int.TryParse(id.AsSpan(6), out var ix) &&
            ix >= 0 && ix < _contasLocais.Count)
        {
            var c = _contasLocais[ix];
            // R34: Conta Depósito = meio.pagamento 2 (vale p/ conta OU Pix)
            if (!string.IsNullOrWhiteSpace(c.PixChave))
            {
                return fav with
                {
                    MeioPagamento = "2",
                    ChavePixTipo  = MapPixTipo(c.PixTipo),
                    ChavePix      = c.PixChave,
                };
            }

            var bancoNum = int.TryParse(new string((c.Banco ?? "").Where(char.IsDigit).ToArray()), out var b) ? b : (int?)null;
            return fav with
            {
                MeioPagamento = "2",
                ContaBanco   = bancoNum,
                ContaAgencia = string.IsNullOrWhiteSpace(c.Agencia) ? null : c.Agencia,
                ContaNumero  = string.IsNullOrWhiteSpace(c.Conta) ? null : c.Conta,
                ContaTipo    = c.Tipo == "CP" ? 2 : 1,
            };
        }

        // Meio vindo do Pamcard FindFavored → passa o identificador
        return fav with { MeioPagamento = id };
    }

