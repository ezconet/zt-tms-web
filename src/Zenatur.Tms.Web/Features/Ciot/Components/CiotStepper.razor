    // ── Fase 2 → 3: Roteirização + Frete Mínimo ANTT ──
    private async Task CalcularRotaEFreteMinimoAsync()
    {
        if (string.IsNullOrEmpty(_vm.ContratanteCnpj) ||
            string.IsNullOrEmpty(_vm.TipoVeiculo)     ||
            string.IsNullOrEmpty(_vm.TipoCarga)       ||
            !int.TryParse(_vm.OrigemIbge,  out var ibgeOrig) ||
            !int.TryParse(_vm.DestinoIbge, out var ibgeDest)) return;

        _calculandoRota = true;
        StateHasChanged();
        try
        {
            var routerTask = CiotClient.Roteirizacao.RouterAsync(new RouterRequest
            {
                ContratanteCnpj  = _vm.ContratanteCnpj,
                VeiculoCategoria = _vm.TipoVeiculo,
                Origem           = new CidadeLocalizacao { Ibge = ibgeOrig },
                Destino          = new CidadeLocalizacao { Ibge = ibgeDest },
                Pontos           = _vm.PontosParada
                                       .Where(p => int.TryParse(p.Ibge, out _))
                                       .Select(p => new CidadeLocalizacao { Ibge = int.Parse(p.Ibge!) })
                                       .ToList(),
                ObterPraca       = true,
                ObterRota        = true,
                IdaVolta         = false,
                ObterUf          = false,
                ObterPostos      = false,
                PedagioCaminho   = 1,
            });

            var router = await routerTask;
            if (router.IsFailed)
            {
                var motivo = string.Join("; ", router.Errors.Select(e => e.Message));
                Snackbar.Add($"Falha rota Pamcard: {motivo}", Severity.Warning);
                return;
            }

            var km = router.Value.Km;
            _vm.DistanciaKm  = km;
            _vm.ValorPedagio = router.Value.PedagioValor;

            if (km <= 0)
            {
                // Mesma cidade (intra-municipal): Pamcard retorna km=0, ANTT não cobre frete mínimo
                _vm.FreteMinimoAntt = null;
                Snackbar.Add("Origem e destino na mesma cidade — sem distância para frete mínimo ANTT.", Severity.Info);
                return;
            }

            await BuscarFreteMinimoAsync(km);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro na roteirização: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _calculandoRota = false;
            StateHasChanged();
        }
    }

    private async Task BuscarFreteMinimoAsync(decimal km)
    {
        if (string.IsNullOrEmpty(_vm.ContratanteCnpj) ||
            string.IsNullOrEmpty(_vm.TipoVeiculo)     ||
            !int.TryParse(_vm.TipoCarga, out var cargaTipo)) return;

        var fm = await CiotClient.Roteirizacao.FindMinimumFreightAsync(new FindMinimumFreightRequest
        {
            ContratanteCnpj  = _vm.ContratanteCnpj,
            VeiculoCategoria = _vm.TipoVeiculo,
            DistanciaKm      = km,
            CargaTipo        = cargaTipo,
            AltoDesempenho   = _vm.AltoDesempenho,
            ContratacaoTipo  = _vm.ContratacaoTipo,
        });

        if (fm.IsSuccess && fm.Value.FreteMinimo > 0)
        {
            _vm.FreteMinimoAntt = fm.Value.FreteMinimo;
            if (_vm.ValorFrete <= 0) _vm.ValorFrete = fm.Value.FreteMinimo;
            RecalcularParcelas();
        }
        else
        {
            var motivo = fm.IsFailed
                ? string.Join("; ", fm.Errors.Select(e => e.Message))
                : "Valor zero retornado";
            Snackbar.Add($"Falha frete mínimo ANTT: {motivo}", Severity.Warning);
        }
    }

    private async Task RecalcularFreteMinimoAsync()
    {
        if (_vm.DistanciaKm is decimal km) await BuscarFreteMinimoAsync(km);
    }

