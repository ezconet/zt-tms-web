    private static List<string> ChecarCamposFavorecido(FavorecidoDto f)
    {
        var faltam = new List<string>();
        if (f.DataNascimento is null)            faltam.Add("Data de Nascimento");
        if (string.IsNullOrWhiteSpace(f.TelefoneDdd) || string.IsNullOrWhiteSpace(f.TelefoneNumero))
            faltam.Add("Telefone");
        if (string.IsNullOrWhiteSpace(f.EnderecoLogradouro)) faltam.Add("Endereço (logradouro)");
