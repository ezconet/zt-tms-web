    private void OnPlacaChanged()
    {
        if (string.IsNullOrEmpty(_vm.VeiculoPlaca)) return;
        // uppercase + remove caracteres não-alfanuméricos (mantém hífen opcional)
        var limpo = new string(_vm.VeiculoPlaca
            .Where(c => char.IsLetterOrDigit(c) || c == '-')
            .ToArray())
            .ToUpperInvariant();
        if (limpo != _vm.VeiculoPlaca) _vm.VeiculoPlaca = limpo;
    }

    private async Task AtualizarUnidadesFiltradasAsync()
    {
        if (string.IsNullOrEmpty(_vm.TipoCarga))
        {
            _unidadesFiltradas = [];
            return;
        }
        var lista = await DomainService.GetUnidadesMedidaAsync(_vm.TipoCarga);
        _unidadesFiltradas = lista.ToList();
    }

    private CidadeIbgeItem? _origemSelecionada;
    private CidadeIbgeItem? _destinoSelecionada;

    private static string RemoverAcentos(string s)
    {
        var norm = s.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(norm.Length);
        foreach (var ch in norm)
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(ch);
        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC);
    }

    private Task<IEnumerable<CidadeIbgeItem>> BuscarCidades(string? termo, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(termo))
            return Task.FromResult(Enumerable.Empty<CidadeIbgeItem>());

        var t = RemoverAcentos(termo.Trim()).ToLowerInvariant();
        var filtro = _cidadesIbge
            .Where(c =>
                RemoverAcentos(c.Cidade).Contains(t, StringComparison.OrdinalIgnoreCase) ||
                c.Uf.Equals(termo.Trim(), StringComparison.OrdinalIgnoreCase))
            .Take(50);

        return Task.FromResult(filtro);
    }

