@using Zenatur.Ciot.Client
@using Zenatur.Ciot.Client.Favorecidos
@using Zenatur.Ciot.Client.Roteirizacao
@using Zenatur.Ciot.Client.Shared
@using Zenatur.Ciot.Client.Viagem
@using Zenatur.Tms.Application.Domain
@using Zenatur.Tms.Application.Favorecidos
@using Zenatur.Tms.Application.LegacyBridge
@using Zenatur.Tms.Application.State
@inject ICiotClient CiotClient
@inject ILegacyBridgeClient Bridge
@inject IDomainService DomainService
@inject CiotStateContainer State
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IWebHostEnvironment Env

<MudStepper @bind-ActiveIndex="_faseIndex"
            NonLinear="false"
            OnPreviewInteraction="OnStepperPreview"
            Class="mb-4">

    @* ── FASE 1: Identificação ── *@
    <MudStep Title="Identificação" HasError="@(!_fase1Valida && (_favorecido is not null || _erroFase1 is not null))">
        <MudGrid Spacing="3" Class="mt-2">

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_vm.ContratanteCnpj"
                              Label="CNPJ Contratante (Zenatur)"
                              Variant="Variant.Outlined"
                              Placeholder="Apenas números — 14 dígitos"
                              HelperText="CNPJ da unidade Zenatur emissora"
                              Immediate="true"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_documentoBusca"
                              Label="CPF / CNPJ do Favorecido"
                              Variant="Variant.Outlined"
                              Placeholder="Apenas números — 11 (CPF) ou 14 (CNPJ)"
                              HelperText="Digite para buscar automaticamente"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_buscando ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.Search)"
                              AdornmentColor="Color.Primary"
                              Immediate="true"
                              Required="true"
                              TextChanged="OnDocumentoChanged" />
            </MudItem>

            @if (_buscando)
            {
                <MudItem xs="12">
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-1" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Buscando favorecido...</MudText>
                </MudItem>
            }

            @if (_erroFase1 is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="false" Icon="@Icons.Material.Filled.Block">
                        <strong>@_erroFase1</strong>
                        <div style="margin-top:4px; font-size:12px;">
                            Corrija o documento ou tente outro favorecido. Avançar está bloqueado.
                        </div>
                        @if (_favorecido is null && _documentoBusca.Where(char.IsDigit).Count() is 11 or 14)
                        {
                            <div style="margin-top:8px;">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           OnClick="AbrirCadastroFavorecido">
                                    Cadastrar Novo Favorecido
                                </MudButton>
                            </div>
                        }
                    </MudAlert>
                </MudItem>
            }

            @{ var fav = _favorecido; }
            @if (fav is not null && !_buscando)
            {
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-4"
                              Style="background:#F9FAFB; border:1px solid #E5E7EB; border-radius:10px;">
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudText Typo="Typo.overline"
                                         Style="color:#9CA3AF; font-size:10px; letter-spacing:1px;">
                                    FAVORECIDO ENCONTRADO
                                    <MudChip T="string" Size="Size.Small" Label="true"
                                             Style="@GetRntrcBadgeStyle()">
                                        @(fav.RntrcAtivo ? "RNTRC Ativo" : "RNTRC Inativo")
                                    </MudChip>
                                </MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Style="color:#6B7280;">Nome</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:600;">@fav.Nome</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Style="color:#6B7280;">Documento</MudText>
                                <MudText Typo="Typo.body1" Style="font-family:monospace;">@FormatDocumento(fav.Documento)</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Style="color:#6B7280;">RNTRC</MudText>
                                <MudText Typo="Typo.body1" Style="font-family:monospace;">@fav.Rntrc</MudText>
                            </MudItem>

                            @if (fav.MeiosPagamento is { Count: > 0 } meios)
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.caption" Style="color:#6B7280; margin-bottom:4px; display:block;">
                                        Meios de Pagamento Disponíveis (@meios.Count)
                                    </MudText>
                                    <MudChipSet T="string">
                                        @foreach (var mp in (_expandirMeios ? meios : meios.Take(6)))
                                        {
                                            <MudChip T="string" Size="Size.Small" Label="true"
                                                     Icon="@(mp.Tipo == "Cartao" ? Icons.Material.Filled.CreditCard : Icons.Material.Filled.AccountBalance)"
                                                     Style="background:#EFF6FF; color:#1D4ED8; font-size:11px;">
                                                @mp.Descricao
                                            </MudChip>
                                        }
                                    </MudChipSet>
                                    @if (meios.Count > 6)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   StartIcon="@(_expandirMeios ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                   OnClick="@(() => _expandirMeios = !_expandirMeios)"
                                                   Style="text-transform:none; font-size:12px;">
                                            @(_expandirMeios ? "Recolher" : $"Ver mais {meios.Count - 6}")
                                        </MudButton>
                                    }
                                </MudItem>
                            }

                            @if (!fav.RntrcAtivo)
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Warning" Dense="true">
                                        RNTRC inativo.
                                        @if (Env.IsDevelopment())
                                        {
                                            <strong> Modo DEV: validação será ignorada para permitir testes.</strong>
                                        }
                                        else
                                        {
                                            <text> Não é possível emitir CIOT.</text>
                                        }
                                    </MudAlert>
                                </MudItem>
                            }

                            @if (_camposFavorecidoFaltantes is { Count: > 0 })
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Warning" Dense="false" Icon="@Icons.Material.Filled.Warning">
                                        <MudText Typo="Typo.body2">
                                            <strong>Campos obrigatórios faltando:</strong> @string.Join(", ", _camposFavorecidoFaltantes)
                                        </MudText>
                                        <MudText Typo="Typo.caption" Style="color:#6B7280;">
                                            Esses campos são exigidos pela Pamcard. Edite o favorecido antes de emitir.
                                        </MudText>
                                        <div style="margin-top:8px;">
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Edit"
                                                       OnClick="AbrirEdicaoFavorecido">
                                                Editar Favorecido
                                            </MudButton>
                                        </div>
                                    </MudAlert>
                                </MudItem>
                            }

                            @if (_veiculosBridge.Count > 0)
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.caption" Style="color:#6B7280; margin-bottom:4px; display:block;">
                                        Veículos vinculados ao motorista (Bridge) — primeiro pré-preenche a placa na Fase 2:
                                    </MudText>
                                    <MudChipSet T="string">
                                        @foreach (var v in _veiculosBridge)
                                        {
                                            <MudChip T="string" Size="Size.Small" Label="true"
                                                     Icon="@Icons.Material.Filled.LocalShipping"
                                                     Style="background:#EFF6FF; color:#1D4ED8; font-size:11px; font-family:monospace;">
                                                @v.Placa.ToUpper() @(string.IsNullOrEmpty(v.TipoVeiculo?.Descricao) ? "" : "· " + v.TipoVeiculo.Descricao) @(string.IsNullOrEmpty(v.Modelo) ? "" : "· " + v.Modelo)
                                            </MudChip>
                                        }
                                    </MudChipSet>
                                </MudItem>
                            }

                            @if (_fontesDados.Count > 0)
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.caption" Style="color:#9CA3AF;">
                                        Dados obtidos com sucesso.
                                    </MudText>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }

        </MudGrid>
    </MudStep>

    @* ── FASE 2: Logística e Veículo ── *@
    <MudStep Title="Logística" HasError="@(!_fase2Valida && _erroFase2 is not null)">
        <MudGrid Spacing="3" Class="mt-2">

            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_vm.TipoVeiculo"
                           Label="Tipo de Veículo"
                           Variant="Variant.Outlined"
                           Required="true"
                           HelperText="Categoria do veículo">
                    @foreach (var v in _tiposVeiculo)
                    {
                        <MudSelectItem Value="@v.Codigo">@v.Descricao</MudSelectItem>
                    }
                </MudSelect>
                @if (_tipoVeiculoBridgeSugestao is not null &&
                     _tipoVeiculoBridgeSugestao.Id > 0 &&
                     !string.IsNullOrWhiteSpace(_tipoVeiculoBridgeSugestao.Descricao))
                {
                    <MudPaper Elevation="0" Class="pa-2 mt-1"
                              Style="background:#FEF3C7; border:1px solid #FCD34D; border-radius:6px;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Style="color:#92400E; font-size:16px;" />
                            <MudText Typo="Typo.caption" Style="color:#92400E;">
                                <strong>Bridge sugere:</strong>
                                @_tipoVeiculoBridgeSugestao.Descricao
                                <span style="opacity:0.7;">(id legado @_tipoVeiculoBridgeSugestao.Id)</span>
                                — escolha o equivalente SEFAZ acima
                            </MudText>
                        </MudStack>
                    </MudPaper>
                }
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_vm.VeiculoPlaca" @bind-Value:after="OnPlacaChanged"
                              Label="Placa do Veículo (Cavalo)"
                              Variant="Variant.Outlined"
                              Placeholder="ABC1D23 ou ABC-1D23"
                              HelperText="Mercosul — 7 caracteres alfanuméricos"
                              Immediate="true"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_vm.TipoCarga" @bind-Value:after="OnTipoCargaChanged"
                           Label="Tipo de Carga"
                           Variant="Variant.Outlined"
                           Required="true"
                           HelperText="Domínio 14 — filtra Unidade de Medida">
                    @foreach (var tc in _tiposCarga)
                    {
                        <MudSelectItem Value="@tc.Codigo">@tc.Descricao</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_vm.UnidadeMedida"
                           Label="Unidade de Medida"
                           Variant="Variant.Outlined"
                           Required="true"
                           Disabled="@(string.IsNullOrEmpty(_vm.TipoCarga))"
                           HelperText="@(_unidadesFiltradas.Count == 0 ? "Selecione o Tipo de Carga primeiro" : $"{_unidadesFiltradas.Count} opções disponíveis")">
                    @foreach (var um in _unidadesFiltradas)
                    {
                        <MudSelectItem Value="@um.Codigo">@um.Descricao</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-1" />
                <MudText Typo="Typo.overline" Style="color:#6B7280; font-size:10px; letter-spacing:1px;">
                    ROTA
                </MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudAutocomplete T="CidadeIbgeItem"
                                 Value="_origemSelecionada"
                                 ValueChanged="OnOrigemAutocompleteChanged"
                                 SearchFunc="BuscarCidades"
                                 ToStringFunc="@(c => c?.Descricao ?? string.Empty)"
                                 Label="Cidade de Origem"
                                 Variant="Variant.Outlined"
                                 Required="true"
                                 HelperText="Digite nome ou UF — setas + Enter para selecionar"
                                 Clearable="true"
                                 MaxItems="50"
                                 MinCharacters="1"
                                 DebounceInterval="200"
                                 OpenOnFocus="false"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.LocationOn" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudAutocomplete T="CidadeIbgeItem"
                                 Value="_destinoSelecionada"
                                 ValueChanged="OnDestinoAutocompleteChanged"
                                 SearchFunc="BuscarCidades"
                                 ToStringFunc="@(c => c?.Descricao ?? string.Empty)"
                                 Label="Cidade de Destino"
                                 Variant="Variant.Outlined"
                                 Required="true"
                                 HelperText="Digite nome ou UF — setas + Enter para selecionar"
                                 Clearable="true"
                                 MaxItems="50"
                                 MinCharacters="1"
                                 DebounceInterval="200"
                                 OpenOnFocus="false"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Flag" />
            </MudItem>

            @if (!string.IsNullOrEmpty(_vm.OrigemDescricao) && !string.IsNullOrEmpty(_vm.DestinoDescricao))
            {
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-3"
                              Style="background:#F9FAFB; border:1px solid #E5E7EB; border-radius:8px;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Route" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">
                                <strong>@_vm.OrigemDescricao</strong>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="mx-1" />
                                <strong>@_vm.DestinoDescricao</strong>
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }

            @if (_erroFase2 is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">@_erroFase2</MudAlert>
                </MudItem>
            }
        </MudGrid>
    </MudStep>

    @* ── FASE 3: Viagem (Data Partida + Documentos) ── *@
    <MudStep Title="Viagem" HasError="@(_erroFase3viagem is not null)">
        <MudGrid Spacing="3" Class="mt-2">

            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_vm.DataPartida"
                               Label="Data da Partida"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy"
                               MinDate="DateTime.Today.AddDays(-30)"
                               MaxDate="DateTime.Today.AddYears(1)"
                               Required="true" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-1" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.overline" Style="color:#6B7280; font-size:10px; letter-spacing:1px;">
                        DOCUMENTOS DA VIAGEM
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AdicionarDocumentoViagem">
                        Adicionar Documento
                    </MudButton>
                </MudStack>
            </MudItem>

            @for (int i = 0; i < _vm.DocumentosViagem.Count; i++)
            {
                var idx = i;
                var doc = _vm.DocumentosViagem[idx];
                <MudItem xs="12" md="5">
                    <MudSelect T="int" @bind-Value="doc.Tipo"
                               Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="1">Manifesto</MudSelectItem>
                        <MudSelectItem Value="2">Romaneio</MudSelectItem>
                        <MudSelectItem Value="3">Plano de Viagem</MudSelectItem>
                        <MudSelectItem Value="5">Conhecimento (CT-e)</MudSelectItem>
                        <MudSelectItem Value="6">Nota Fiscal (NF-e)</MudSelectItem>
                        <MudSelectItem Value="7">Documento do Cliente</MudSelectItem>
                        <MudSelectItem Value="8">Pedido</MudSelectItem>
                        <MudSelectItem Value="11">Ordem de Coleta</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="10" md="6">
                    <MudTextField @bind-Value="doc.Numero"
                                  Label="Número" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
                <MudItem xs="2" md="1" Class="d-flex align-center">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => _vm.DocumentosViagem.RemoveAt(idx))" />
                </MudItem>
            }
            @if (_vm.DocumentosViagem.Count == 0)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Adicione ao menos 1 documento (NF-e, CT-e, manifesto, etc) antes da emissão.
                    </MudAlert>
                </MudItem>
            }

            @if (_erroFase3viagem is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">@_erroFase3viagem</MudAlert>
                </MudItem>
            }
        </MudGrid>
    </MudStep>

    @* ── FASE 4: Valores e Parcelas ── *@
    <MudStep Title="Valores">
        <MudGrid Spacing="3" Class="mt-2">

            @if (_vm.DistanciaKm is decimal km && _vm.FreteMinimoAntt is decimal freteMin)
            {
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-3"
                              Style="background:#FFF8E1; border:1px solid #FBC02D; border-radius:8px;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudIcon Icon="@Icons.Material.Filled.Route" Color="Color.Warning" />
                            <MudText Typo="Typo.body2">
                                <strong>Rota Pamcard:</strong> @km.ToString("N0", _culturaBr) km
                                · <strong>Pedágio:</strong> @_vm.ValorPedagio.ToString("C", _culturaBr)
                                · <strong>Frete mínimo ANTT:</strong> @freteMin.ToString("C", _culturaBr)
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }

            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_vm.ContratacaoTipo" @bind-Value:after="RecalcularFreteMinimoAsync"
                           Label="Tipo de Contratação"
                           Variant="Variant.Outlined"
                           Required="true"
                           HelperText="Pamcard TipoContratacao">
                    <MudSelectItem Value="@("1")">Carga Lotação</MudSelectItem>
                    <MudSelectItem Value="@("2")">Contratação Apenas do Veículo Automotor de Cargas</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCheckBox T="bool" @bind-Value="_vm.AltoDesempenho" @bind-Value:after="RecalcularFreteMinimoAsync"
                             Label="Veículo de alto desempenho (ANTT Res. 5867/2020)"
                             Color="Color.Primary" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudNumericField T="decimal" @bind-Value="_vm.ValorFrete" @bind-Value:after="RecalcularParcelas"
                                 Label="Valor do Frete (R$)"
                                 Variant="Variant.Outlined"
                                 Format="N2" Culture="@_culturaBr"
                                 Min="0m" HideSpinButtons="false"
                                 Immediate="true"
                                 Required="true"
                                 HelperText="@(_vm.FreteMinimoAntt is decimal fm ? $"ANTT mínimo: {fm.ToString("C", _culturaBr)}" : "Valor bruto da operação")" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudNumericField T="decimal" @bind-Value="_vm.ValorPedagio"
                                 Label="Valor do Pedágio (R$)"
                                 Variant="Variant.Outlined"
                                 Format="N2" Culture="@_culturaBr"
                                 Min="0m" HideSpinButtons="false"
                                 HelperText="Pedágios da rota" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudNumericField T="decimal" @bind-Value="_vm.ValorImpostos"
                                 Label="Impostos / INSS (R$)"
                                 Variant="Variant.Outlined"
                                 Format="N2" Culture="@_culturaBr"
                                 Min="0m" HideSpinButtons="false"
                                 HelperText="Retenções a deduzir" />
            </MudItem>

            @if (_vm.FreteMinimoAntt is decimal min2 && _vm.ValorFrete > 0 && _vm.ValorFrete < min2)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true" Icon="@Icons.Material.Filled.Warning">
                        Valor de frete (@_vm.ValorFrete.ToString("C", _culturaBr)) abaixo do mínimo ANTT (@min2.ToString("C", _culturaBr)).
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-3"
                          Style="background:#F9FAFB; border:1px solid #E5E7EB; border-radius:8px;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2" Style="color:#6B7280;">
                            Frete + Pedágio − Impostos
                        </MudText>
                        <MudText Typo="Typo.h6" Style="color:#AD1F0B; font-weight:700;">
                            @_vm.ValorLiquido.ToString("C", _culturaBr)
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-1" />
                <MudText Typo="Typo.overline" Style="color:#6B7280; font-size:10px; letter-spacing:1px;">
                    PAGAMENTO
                </MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_vm.MeioPagamento"
                           Label="Meio de Pagamento"
                           Variant="Variant.Outlined"
                           Required="true"
                           HelperText="@(_meiosFavorecido.Count == 0 ? "Favorecido sem meios cadastrados" : $"{_meiosFavorecido.Count} vinculado(s) ao favorecido")"
                           Disabled="@(_meiosFavorecido.Count == 0)">
                    @foreach (var mp in _meiosFavorecido)
                    {
                        <MudSelectItem Value="@mp.Identificador">@($"{mp.Tipo} — {mp.Descricao}")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudNumericField T="int" @bind-Value="_vm.ParcelasQuantidade" @bind-Value:after="RecalcularParcelas"
                                 Label="Qtd. Parcelas"
                                 Variant="Variant.Outlined"
                                 Min="1" Max="12"
                                 Required="true" />
            </MudItem>

            <MudItem xs="12" md="3">
                <MudDatePicker @bind-Date="_vm.DataVencimento" @bind-Date:after="RecalcularParcelas"
                               Label="1º Vencimento"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy"
                               MinDate="DateTime.Today"
                               Required="true" />
            </MudItem>

            @if (_vm.Parcelas.Count > 0)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.overline" Class="mb-2" Style="color:#6B7280; font-size:10px; letter-spacing:1px;">
                        CRONOGRAMA DE PARCELAS
                    </MudText>
                    <MudTable Items="_vm.Parcelas" Dense="true" Hover="true" Elevation="0"
                              Style="border:1px solid #E5E7EB; border-radius:8px;">
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Vencimento</MudTh>
                            <MudTh Style="text-align:right;">Valor</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Numero</MudTd>
                            <MudTd>@context.Vencimento.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd Style="text-align:right; font-weight:600;">@context.Valor.ToString("C", _culturaBr)</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>
            }

            @if (_erroFase3 is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">@_erroFase3</MudAlert>
                </MudItem>
            }
        </MudGrid>
    </MudStep>

    @* ── FASE 4: Revisão e Emissão ── *@
    <MudStep Title="Revisão">
        @if (_protocoloEmitido is null)
        {
            <MudGrid Spacing="3" Class="mt-2">

                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.Info">
                        Confira todos os dados antes de emitir. Após confirmar, o CIOT será gerado e sincronizado.
                    </MudAlert>
                </MudItem>

                @* Card: Identificação *@
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid #E5E7EB; border-radius:10px; height:100%;">
                        <MudText Typo="Typo.overline" Style="color:#9CA3AF; font-size:10px; letter-spacing:1px;">IDENTIFICAÇÃO</MudText>
                        <MudDivider Class="my-2" />
                        @ReviewRow("Contratante CNPJ", _vm.ContratanteCnpj)
                        @ReviewRow("Favorecido",       _vm.FavorecidoNome)
                        @ReviewRow("Documento",        _vm.FavorecidoDocumento, Mono: true)
                        @ReviewRow("RNTRC",            _vm.FavorecidoRntrc, Mono: true)
                    </MudPaper>
                </MudItem>

                @* Card: Logística *@
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid #E5E7EB; border-radius:10px; height:100%;">
                        <MudText Typo="Typo.overline" Style="color:#9CA3AF; font-size:10px; letter-spacing:1px;">LOGÍSTICA E VEÍCULO</MudText>
                        <MudDivider Class="my-2" />
                        @ReviewRow("Veículo",   _tiposVeiculo.FirstOrDefault(v => v.Codigo == _vm.TipoVeiculo)?.Descricao)
                        @ReviewRow("Placa",     _vm.VeiculoPlaca, Mono: true)
                        @ReviewRow("Carga",     $"{_tiposCarga.FirstOrDefault(c => c.Codigo == _vm.TipoCarga)?.Descricao} ({_vm.UnidadeMedida})")
                        @ReviewRow("Rota",      $"{_vm.OrigemDescricao} → {_vm.DestinoDescricao}")
                        @if (_vm.DocumentosViagem.Count > 0)
                        {
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.overline" Style="color:#9CA3AF; font-size:10px; letter-spacing:1px;">DOCUMENTOS DA VIAGEM</MudText>
                            @foreach (var d in _vm.DocumentosViagem)
                            {
                                @ReviewRow(DescricaoTipoDocViagem(d.Tipo), d.Numero, Mono: true)
                            }
                        }
                    </MudPaper>
                </MudItem>

                @* Card: Valores *@
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid #E5E7EB; border-radius:10px; height:100%;">
                        <MudText Typo="Typo.overline" Style="color:#9CA3AF; font-size:10px; letter-spacing:1px;">VALORES</MudText>
                        <MudDivider Class="my-2" />
                        @ReviewRow("Frete",     _vm.ValorFrete.ToString("C", _culturaBr))
                        @ReviewRow("Pedágio",   _vm.ValorPedagio.ToString("C", _culturaBr))
                        @ReviewRow("Impostos",  _vm.ValorImpostos.ToString("C", _culturaBr))
                        <MudDivider Class="my-2" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Style="color:#374151; font-weight:600;">Valor Líquido</MudText>
                            <MudText Typo="Typo.h6" Style="color:#AD1F0B; font-weight:700;">@_vm.ValorLiquido.ToString("C", _culturaBr)</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                @* Card: Pagamento + Parcelas *@
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid #E5E7EB; border-radius:10px; height:100%;">
                        <MudText Typo="Typo.overline" Style="color:#9CA3AF; font-size:10px; letter-spacing:1px;">PAGAMENTO</MudText>
                        <MudDivider Class="my-2" />
                        @ReviewRow("Meio",      _meiosFavorecido.FirstOrDefault(m => m.Identificador == _vm.MeioPagamento)?.Descricao)
                        @ReviewRow("Parcelas",  $"{_vm.ParcelasQuantidade}× a partir de {_vm.DataVencimento:dd/MM/yyyy}")
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.caption" Style="color:#6B7280;">@($"{_vm.Parcelas.Count} parcela(s) gerada(s)")</MudText>
                    </MudPaper>
                </MudItem>

                @if (_erroFase4 is not null)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" Dense="false" Icon="@Icons.Material.Filled.Error">
                            <strong>Falha ao emitir CIOT</strong>
                            <div style="margin-top:4px;">@_erroFase4</div>
                        </MudAlert>
                    </MudItem>
                }

                <MudItem xs="12" Class="d-flex justify-end mt-2">
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               OnClick="ConfirmarEmissao"
                               Disabled="_emitindo">
                        Confirmar Emissão
                    </MudButton>
                </MudItem>
            </MudGrid>
        }
        else
        {
            @* Sucesso: protocolo emitido *@
            <MudGrid Spacing="3" Class="mt-2">
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-6"
                              Style="background:linear-gradient(135deg,#D1FAE5 0%,#A7F3D0 100%); border:1px solid #10B981; border-radius:12px; text-align:center;">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:56px; color:#065F46;" />
                        <MudText Typo="Typo.h5" Style="color:#065F46; font-weight:700; margin-top:8px;">
                            Emissão Confirmada
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color:#047857; margin-top:4px;">
                            CIOT gerado com sucesso. Sincronização com base legada em andamento (background via Outbox).
                        </MudText>

                        <MudPaper Elevation="0" Class="pa-3 mt-4" Style="background:white; border-radius:8px; display:inline-block;">
                            <MudText Typo="Typo.caption" Style="color:#6B7280;">PROTOCOLO</MudText>
                            <MudText Typo="Typo.h6" Style="font-family:monospace; color:#111827;">@_protocoloEmitido</MudText>
                        </MudPaper>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" Class="d-flex justify-center gap-2">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Dashboard"
                               Href="/ciot/dashboard">
                        Ir para Dashboard
                    </MudButton>
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="NovaEmissao">
                        Nova Emissão
                    </MudButton>
                </MudItem>
            </MudGrid>
        }
    </MudStep>

</MudStepper>

<MudOverlay Visible="_calculandoRota" DarkBackground="true" ZIndex="9999">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Style="color:white;">Calculando rota e frete mínimo na Pamcard...</MudText>
    </MudStack>
</MudOverlay>

<MudOverlay Visible="_emitindo" DarkBackground="true" ZIndex="9999">
    <div style="text-align:center; color:white;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Class="mt-3" Style="color:white;">Processando emissão CIOT...</MudText>
        <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.7);">Aguarde, isso pode levar alguns segundos.</MudText>
    </div>
</MudOverlay>

@code {
    private int _faseIndex;

    private EmissaoViewModel _vm = new();
    private string _documentoBusca = string.Empty;

    private bool _buscando;
    private bool _calculandoRota;
    private bool _expandirMeios;
    private bool _emitindo;
    private string? _erroFase1;
    private string? _erroFase2;
    private string? _erroFase3viagem;
    private string? _erroFase3;
    private string? _erroFase4;
    private string? _protocoloEmitido;
    private FavorecidoDto? _favorecido;
    private List<string> _fontesDados = [];
    private bool _prioridadeBridge; // futuro A14-A17: priority quando Bridge entrar

    private bool _fase1Valida =>
        !string.IsNullOrWhiteSpace(_vm.ContratanteCnpj) &&
        _favorecido is not null &&
        (_favorecido.RntrcAtivo || Env.IsDevelopment()); // dev bypass — bug 1.7

    private static readonly System.Text.RegularExpressions.Regex _placaRegex = new(
        @"^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$",
        System.Text.RegularExpressions.RegexOptions.Compiled);

    private bool _fase2Valida =>
        !string.IsNullOrWhiteSpace(_vm.TipoVeiculo) &&
        !string.IsNullOrWhiteSpace(_vm.TipoCarga) &&
        !string.IsNullOrWhiteSpace(_vm.UnidadeMedida) &&
        !string.IsNullOrEmpty(_vm.OrigemIbge) &&
        !string.IsNullOrEmpty(_vm.DestinoIbge) &&
        PlacaValida(_vm.VeiculoPlaca);

    private static bool PlacaValida(string? placa)
    {
        if (string.IsNullOrWhiteSpace(placa)) return false;
        var limpa = placa.Replace("-", "").ToUpperInvariant();
        return _placaRegex.IsMatch(limpa);
    }

    private CancellationTokenSource? _debounce;

    // ── Fase 2: domínios via DomainService (cache T17) + veículos do Bridge ──
    private IReadOnlyList<DomainItem>     _tiposVeiculo      = [];
    private IReadOnlyList<DomainItem>     _tiposCarga        = [];
    private IReadOnlyList<CidadeIbgeItem> _cidadesIbge       = [];
    private List<UnidadeMedidaItem>       _unidadesFiltradas = [];
    private IReadOnlyList<VeiculoMotoristaItem> _veiculosBridge = [];
    private TipoVeiculoLegado? _tipoVeiculoBridgeSugestao;

    // ── Fase 3: cultura BR para formatação + meios do favorecido ──
    private static readonly System.Globalization.CultureInfo _culturaBr = new("pt-BR");
    private IReadOnlyList<MeioPagamentoDto> _meiosFavorecido = [];

    protected override async Task OnInitializedAsync()
    {
        if (State.EmissaoEmAndamento is not null)
        {
            _vm = State.EmissaoEmAndamento;
            _documentoBusca = _vm.FavorecidoDocumento ?? string.Empty;
            _faseIndex = State.FaseAtual > 0 ? State.FaseAtual - 1 : 0;
        }
        else
        {
            State.IniciarEmissao(_vm);
        }

        // Carrega domínios em paralelo (cached)
        var veiculosTask = DomainService.GetTiposVeiculoAsync();
        var cargasTask   = DomainService.GetTiposCargaAsync();
        var cidadesTask  = DomainService.GetCidadesAsync();
        await Task.WhenAll(veiculosTask, cargasTask, cidadesTask);
        _tiposVeiculo = veiculosTask.Result;
        _tiposCarga   = cargasTask.Result;
        _cidadesIbge  = cidadesTask.Result;

        await AtualizarUnidadesFiltradasAsync();

        // Restaura seleção visual dos autocompletes se sessão reaberta com cidades já escolhidas
        if (!string.IsNullOrEmpty(_vm.OrigemIbge))
            _origemSelecionada = _cidadesIbge.FirstOrDefault(c => c.Ibge == _vm.OrigemIbge);
        if (!string.IsNullOrEmpty(_vm.DestinoIbge))
            _destinoSelecionada = _cidadesIbge.FirstOrDefault(c => c.Ibge == _vm.DestinoIbge);

        // Restaura meios do favorecido se já existia (sessão re-aberta)
        if (_favorecido is not null) _meiosFavorecido = _favorecido.MeiosPagamento;

        // F5/reentry: state container guardou doc do favorecido mas _favorecido (card UI) é volátil → re-busca
        if (_favorecido is null && !string.IsNullOrEmpty(_vm.FavorecidoDocumento))
        {
            await BuscarFavorecido(_vm.FavorecidoDocumento);
        }
    }

    private async Task OnDocumentoChanged(string valor)
    {
        _documentoBusca = valor;
        _erroFase1      = null;
        _favorecido     = null;

        var digits = new string(valor.Where(char.IsDigit).ToArray());

        if (digits.Length < 11) return;

        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try   { await Task.Delay(500, token); }
        catch (TaskCanceledException) { return; }

        await BuscarFavorecido(digits);
    }

    private async Task BuscarFavorecido(string documento)
    {
        _buscando = true;
        _fontesDados = [];
        _prioridadeBridge = false;
        StateHasChanged();

        try
        {
            // Pamcard contract: 1=CNPJ, 2=CPF, 5=RNTRC PF, 6=RNTRC PJ
            var docTipo  = documento.Length == 11 ? 2 : 1;

            // 2 fontes em paralelo (CIOT + LegacyBridge)
            var ciotTask = CiotClient.Favorecidos.FindAsync(new FindFavoredRequest
            {
                ContratanteCnpj     = _vm.ContratanteCnpj ?? string.Empty,
                FavorecidoDocNumero = documento,
                FavorecidoDocTipo   = docTipo,
                ObterCartao         = true,
                ObterConta          = true,
            });
            // Bridge agora aceita CPF e CNPJ no mesmo endpoint /motoristas (digits only)
            var bridgeTask = Bridge.GetMotoristaAsync(documento);

            await Task.WhenAll(ciotTask, bridgeTask);

            var ciotResult   = ciotTask.Result.IsSuccess   ? ciotTask.Result.Value   : null;
            var bridgeResult = bridgeTask.Result.IsSuccess ? bridgeTask.Result.Value : null;

            if (ciotResult   is not null) _fontesDados.Add("CIOT");
            if (bridgeResult is not null) _fontesDados.Add("Bridge");

            if (ciotResult is null && bridgeResult is null)
            {
                _erroFase1 = "Favorecido não encontrado. Verifique o documento ou cadastre o favorecido antes de emitir.";
                return;
            }

            var novoFavorecido = FavorecidoMerger.Merge(ciotResult, bridgeResult, documento);
            if (novoFavorecido is null)
            {
                _erroFase1 = "Favorecido não encontrado.";
                return;
            }

            // M1: troca de favorecido com dados preenchidos → confirma limpeza
            // Bug 1.11: _favorecido foi zerado em OnDocumentoChanged. Usa _vm.FavorecidoDocumento (persiste no state).
            var docAnterior  = _vm.FavorecidoDocumento;
            var nomeAnterior = _vm.FavorecidoNome ?? "anterior";
            var trocouFavorecido =
                !string.IsNullOrEmpty(docAnterior) &&
                docAnterior != novoFavorecido.Documento;

            if (trocouFavorecido && PossuiDadosFasesPosteriores())
            {
                var confirma = await DialogService.ShowMessageBoxAsync(
                    title:      "Trocar favorecido?",
                    message:    $"Você trocou o favorecido de {nomeAnterior} para {novoFavorecido.Nome}. " +
                                "Dados das próximas fases (veículo, valores, parcelas) serão limpos. Continuar?",
                    yesText:    "Limpar e trocar",
                    noText:     null,
                    cancelText: "Manter anterior",
                    options:    null);

                if (confirma != true)
                {
                    _documentoBusca = docAnterior!;
                    Snackbar.Add("Troca cancelada. Favorecido anterior mantido.", Severity.Info);
                    return;
                }

                LimparDadosFasesPosteriores();
            }

            _favorecido        = novoFavorecido;
            _prioridadeBridge  = bridgeResult is not null;
            _meiosFavorecido   = _favorecido.MeiosPagamento;

            _vm.FavorecidoDocumento = documento;
            _vm.FavorecidoNome      = _favorecido.Nome;
            _vm.FavorecidoRntrc     = _favorecido.Rntrc;

            // Pré-popula Fase 2 com primeiro veículo do Bridge (se houver).
            // De/Para legado→Pamcard só para códigos de alta confiança (TipoVeiculoLegadoMapper).
            _veiculosBridge = bridgeResult?.Veiculos ?? [];
            _tipoVeiculoBridgeSugestao = _veiculosBridge.FirstOrDefault()?.TipoVeiculo;
            var v = _veiculosBridge.FirstOrDefault();
            if (v is not null && string.IsNullOrEmpty(_vm.VeiculoPlaca))
            {
                _vm.VeiculoPlaca = v.Placa.Replace("-", "").ToUpperInvariant();
            }
            if (v?.TipoVeiculo is not null && string.IsNullOrEmpty(_vm.TipoVeiculo))
            {
                var pamcardId = TipoVeiculoLegadoMapper.MapearParaPamcard(v.TipoVeiculo.Id);
                if (pamcardId is not null) _vm.TipoVeiculo = pamcardId;
            }

            // reset meio pagamento se já tinha selecionado e não está mais disponível
            if (!string.IsNullOrEmpty(_vm.MeioPagamento) &&
                !_meiosFavorecido.Any(m => m.Identificador == _vm.MeioPagamento))
            {
                _vm.MeioPagamento = null;
            }
        }
        catch (Exception ex)
        {
            _erroFase1 = $"Erro ao buscar favorecido: {ex.Message}";
        }
        finally
        {
            _buscando = false;
        }
    }

    private async Task OnStepperPreview(StepperInteractionEventArgs args)
    {
        // Próximo button → StepAction.Complete; header click → StepAction.Activate.
        if (args.Action != StepAction.Activate && args.Action != StepAction.Complete)
            return;

        var saindoDe = _faseIndex;
        var indoPara = args.Action == StepAction.Complete ? saindoDe + 1 : args.StepIndex;

        if (indoPara <= saindoDe) return;

        // ── Fase 1 → 2 ──
        if (saindoDe == 0)
        {
            if (string.IsNullOrWhiteSpace(_vm.ContratanteCnpj))
            {
                Snackbar.Add("Informe o CNPJ do Contratante.", Severity.Warning);
                args.Cancel = true;
                return;
            }
            if (_favorecido is null)
            {
                Snackbar.Add("Busque e selecione um Favorecido.", Severity.Warning);
                args.Cancel = true;
                return;
            }
            if (!_favorecido.RntrcAtivo)
            {
                if (!Env.IsDevelopment())
                {
                    Snackbar.Add("RNTRC inativo — emissão não permitida.", Severity.Error);
                    args.Cancel = true;
                    return;
                }
                // Dev bypass — bug 1.7: legado sempre retorna ativo:null/false
                Snackbar.Add("⚠ Modo DEV: RNTRC inativo ignorado.", Severity.Warning);
            }
            State.AvancarFase();
        }
        // ── Fase 2 → 3 ──
        else if (saindoDe == 1)
        {
            _erroFase2 = null;

            if (string.IsNullOrWhiteSpace(_vm.TipoVeiculo))
            { _erroFase2 = "Selecione o Tipo de Veículo."; args.Cancel = true; return; }

            if (!PlacaValida(_vm.VeiculoPlaca))
            { _erroFase2 = "Placa inválida — padrão antigo (ABC1234) ou Mercosul (ABC1D23)."; args.Cancel = true; return; }

            if (string.IsNullOrWhiteSpace(_vm.TipoCarga))
            { _erroFase2 = "Selecione o Tipo de Carga."; args.Cancel = true; return; }

            if (string.IsNullOrWhiteSpace(_vm.UnidadeMedida))
            { _erroFase2 = "Selecione a Unidade de Medida."; args.Cancel = true; return; }

            if (string.IsNullOrEmpty(_vm.OrigemIbge))
            { _erroFase2 = "Selecione a cidade de Origem."; args.Cancel = true; return; }

            if (string.IsNullOrEmpty(_vm.DestinoIbge))
            { _erroFase2 = "Selecione a cidade de Destino."; args.Cancel = true; return; }

            await CalcularRotaEFreteMinimoAsync();
            State.AvancarFase();
        }
        // ── Fase 3 (Viagem) → 4 (Valores) ──
        else if (saindoDe == 2)
        {
            _erroFase3viagem = null;

            if (_vm.DataPartida is null)
            { _erroFase3viagem = "Informe a data de partida."; args.Cancel = true; return; }

            if (_vm.DocumentosViagem.Count == 0 || _vm.DocumentosViagem.Any(d => string.IsNullOrWhiteSpace(d.Numero)))
            { _erroFase3viagem = "Adicione ao menos 1 documento de viagem com número válido."; args.Cancel = true; return; }

            State.AvancarFase();
        }
        // ── Fase 4 (Valores) → 5 (Revisão) ──
        else if (saindoDe == 3)
        {
            _erroFase3 = null;

            if (_vm.ValorFrete <= 0)
            { _erroFase3 = "Valor do Frete deve ser maior que zero."; args.Cancel = true; return; }

            if (_vm.ValorLiquido <= 0)
            { _erroFase3 = "Valor líquido (Frete + Pedágio − Impostos) deve ser positivo."; args.Cancel = true; return; }

            if (string.IsNullOrEmpty(_vm.MeioPagamento))
            { _erroFase3 = "Selecione o Meio de Pagamento."; args.Cancel = true; return; }

            if (!_meiosFavorecido.Any(m => m.Identificador == _vm.MeioPagamento))
            { _erroFase3 = "Meio de pagamento selecionado não está vinculado ao favorecido."; args.Cancel = true; return; }

            if (_vm.DataVencimento is null || _vm.DataVencimento.Value.Date < DateTime.Today)
            { _erroFase3 = "Data de vencimento deve ser hoje ou futura."; args.Cancel = true; return; }

            if (_vm.Parcelas.Count == 0)
            { _erroFase3 = "Cronograma de parcelas inválido — revise os valores."; args.Cancel = true; return; }

            State.AvancarFase();
        }

        return;
    }

    private void AdicionarDocumentoViagem()
    {
        _vm.DocumentosViagem.Add(new DocumentoViagemViewModel { Tipo = 6 });
    }

    private static string DescricaoTipoDocViagem(int tipo) => tipo switch
    {
        1  => "Manifesto",
        2  => "Romaneio",
        3  => "Plano de Viagem",
        5  => "CT-e",
        6  => "NF-e",
        7  => "Doc. Cliente",
        8  => "Pedido",
        11 => "Ordem de Coleta",
        _  => $"Tipo {tipo}",
    };

    private IReadOnlyList<string>? _camposFavorecidoFaltantes => _favorecido is null ? null : ChecarCamposFavorecido(_favorecido);

    private static List<string> ChecarCamposFavorecido(FavorecidoDto f)
    {
        var faltam = new List<string>();
        if (f.DataNascimento is null)            faltam.Add("Data de Nascimento");
        if (string.IsNullOrWhiteSpace(f.TelefoneDdd) || string.IsNullOrWhiteSpace(f.TelefoneNumero))
            faltam.Add("Telefone");
        if (string.IsNullOrWhiteSpace(f.EnderecoLogradouro)) faltam.Add("Endereço (logradouro)");
        if (string.IsNullOrWhiteSpace(f.EnderecoBairro))     faltam.Add("Bairro");
        if (string.IsNullOrWhiteSpace(f.EnderecoUf))         faltam.Add("UF");
        if (string.IsNullOrWhiteSpace(f.EnderecoCep))        faltam.Add("CEP");
        return faltam;
    }

