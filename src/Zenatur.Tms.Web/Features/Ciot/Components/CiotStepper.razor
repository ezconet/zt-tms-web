    // ── Fase 4: emissão ──
    private async Task ConfirmarEmissao()
    {
        _emitindo  = true;
        _erroFase4 = null;
        StateHasChanged();

        try
        {
            // Pamcard: 1=CNPJ, 2=CPF (mesma convenção do bug 1.13)
            var docTipo = (_vm.FavorecidoDocumento?.Length ?? 0) == 11 ? 2 : 1;

            // Sem fallbacks — favorecido deve estar completo (Bridge ou cadastro manual)
            if (_favorecido?.DataNascimento is null)
            {
                _erroFase4 = "Data de nascimento do favorecido não informada. Edite o favorecido na Fase 1.";
                _emitindo = false;
                StateHasChanged();
                return;
            }
            if (string.IsNullOrWhiteSpace(_favorecido.TelefoneDdd) || string.IsNullOrWhiteSpace(_favorecido.TelefoneNumero))
            {
                _erroFase4 = "Telefone do favorecido não informado. Edite o favorecido na Fase 1.";
                _emitindo = false;
                StateHasChanged();
                return;
            }

            int? enderecoIbge = int.TryParse(_favorecido.EnderecoCidadeIbge, out var eIbge) ? eIbge : null;
            int? enderecoNum  = int.TryParse(_favorecido.EnderecoNumero,     out var eNum)  ? eNum  : null;

            var request = new InsertTripRequest
            {
                ContratanteCnpj = _vm.ContratanteCnpj ?? string.Empty,
                DataPartida     = _vm.DataPartida?.ToString("dd/MM/yyyy") ?? DateTime.Today.ToString("dd/MM/yyyy"),
                Favorecidos =
                [
                    new FavorecidoItem
                    {
                        Tipo = docTipo,
                        Nome = _vm.FavorecidoNome ?? string.Empty,
                        Documentos =
                        [
                            new DocumentoFavorecidoItem
                            {
                                Tipo   = docTipo,
                                Numero = _vm.FavorecidoDocumento ?? string.Empty,
                            }
                        ],
                        DataNascimento     = _favorecido.DataNascimento.Value,
                        TelefoneDdd        = _favorecido.TelefoneDdd,
                        TelefoneNumero     = _favorecido.TelefoneNumero,
                        EnderecoIbge       = enderecoIbge,
                        EnderecoLogradouro = _favorecido.EnderecoLogradouro,
                        EnderecoNumero     = enderecoNum,
                        EnderecoBairro     = _favorecido.EnderecoBairro,
                        EnderecoUf         = _favorecido.EnderecoUf,
                        EnderecoCep        = _favorecido.EnderecoCep,
                    }
                ],
                VeiculoPlaca     = _vm.VeiculoPlaca?.Replace("-", ""),
                VeiculoCategoria = _vm.TipoVeiculo,
                Origem  = int.TryParse(_vm.OrigemIbge,  out var orig) ? new CidadeLocalizacao { Ibge = orig } : null,
                Destino = int.TryParse(_vm.DestinoIbge, out var dest) ? new CidadeLocalizacao { Ibge = dest } : null,
                PedagioValor = _vm.ValorPedagio,
                Documentos = _vm.DocumentosViagem.Select(d => new DocumentoViagemItem
                {
                    Tipo   = d.Tipo,
                    Numero = d.Numero,
                }).ToList(),
                Parcelas = _vm.Parcelas.Select(p => new ParcelaItem
                {
                    Data  = DateOnly.FromDateTime(p.Vencimento),
                    Valor = p.Valor,
                }).ToList(),
            };

            var result = await CiotClient.Viagem.InsertTripAsync(request);

            if (result.IsFailed)
            {
                _erroFase4 = string.Join("; ", result.Errors.Select(e => e.Message));
                Snackbar.Add("Falha na emissão — verifique os detalhes.", Severity.Error);
                return;
            }

            var ok = result.Value;
            _protocoloEmitido = $"{ok.ViagemId}-{ok.ViagemDigito}";
            _vm.CiotProtocolo = _protocoloEmitido;
            _vm.CiotNumero    = ok.ViagemId;
            Snackbar.Add("CIOT emitido com sucesso!", Severity.Success);
        }
        catch (Exception ex)
        {
            _erroFase4 = $"Erro inesperado: {ex.Message}";
            Snackbar.Add("Erro inesperado na emissão.", Severity.Error);
        }
        finally
        {
            _emitindo = false;
            StateHasChanged();
        }
    }

    private void NovaEmissao()
    {
        State.Limpar();
        _vm = new EmissaoViewModel();
        _documentoBusca   = string.Empty;
        _favorecido       = null;
        _meiosFavorecido  = [];
        _unidadesFiltradas= [];
        _fontesDados      = [];
        _protocoloEmitido = null;
        _erroFase1 = _erroFase2 = _erroFase3 = _erroFase4 = null;
        _faseIndex = 0;
        State.IniciarEmissao(_vm);
    }

    // ── Fase 3: parcelas ──
    private void RecalcularParcelas()
    {
        if (_vm.ParcelasQuantidade < 1)  _vm.ParcelasQuantidade = 1;
        if (_vm.ParcelasQuantidade > 12) _vm.ParcelasQuantidade = 12;

        _vm.Parcelas = _vm.DataVencimento is null
            ? []
            : ParcelaCalculator.Calcular(_vm.ValorLiquido, _vm.ParcelasQuantidade, _vm.DataVencimento.Value);
    }

    private string GetRntrcBadgeStyle() =>
        _favorecido?.RntrcAtivo == true
            ? "background:#D1FAE5;color:#065F46;font-size:10px;height:18px;margin-left:6px;"
            : "background:#FEE2E2;color:#991B1B;font-size:10px;height:18px;margin-left:6px;";

    private static string FormatDocumento(string doc) =>
        doc.Length == 11
            ? $"{doc[..3]}.{doc[3..6]}.{doc[6..9]}-{doc[9..]}"
            : $"{doc[..2]}.{doc[2..5]}.{doc[5..8]}/{doc[8..12]}-{doc[12..]}";

    // M1: detecção e limpeza de dados ao trocar favorecido
    private bool PossuiDadosFasesPosteriores() =>
        !string.IsNullOrEmpty(_vm.VeiculoPlaca) ||
        !string.IsNullOrEmpty(_vm.TipoVeiculo)  ||
        !string.IsNullOrEmpty(_vm.TipoCarga)    ||
        !string.IsNullOrEmpty(_vm.OrigemIbge)   ||
        !string.IsNullOrEmpty(_vm.DestinoIbge)  ||
        _vm.ValorFrete    > 0 ||
        _vm.ValorPedagio  > 0 ||
        _vm.ValorImpostos > 0 ||
        !string.IsNullOrEmpty(_vm.MeioPagamento);

    private void LimparDadosFasesPosteriores()
    {
        // mantém Contratante (Fase 1 conserva) e favorecido será atualizado depois
        _vm.TipoVeiculo      = null;
        _vm.VeiculoPlaca     = null;
        _vm.TipoCarga        = null;
        _vm.UnidadeMedida    = null;
        _vm.OrigemIbge       = null;
        _vm.OrigemDescricao  = null;
        _vm.DestinoIbge      = null;
        _vm.DestinoDescricao = null;
        _vm.ValorFrete       = 0;
        _vm.ValorPedagio     = 0;
        _vm.ValorImpostos    = 0;
        _vm.DataVencimento   = null;
        _vm.ParcelasQuantidade = 1;
        _vm.MeioPagamento    = null;
        _vm.Parcelas         = [];
        _meiosFavorecido     = [];
        _veiculosBridge      = [];
        _tipoVeiculoBridgeSugestao = null;
        _faseIndex           = 0; // volta visualmente para Fase 1
    }
}

