@using Zenatur.Tms.Application.Composicoes
@using Zenatur.Tms.Application.Veiculos
@inject IComposicaoManagementService Service
@inject IVeiculoManagementService VeiculoService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(IsEdicao ? Icons.Material.Filled.Edit : Icons.Material.Filled.Link)" />
            <MudText Typo="Typo.h6">@(IsEdicao ? "Editar Composição" : "Nova Composição")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="7">
                <MudTextField @bind-Value="_form.Nome" Label="Nome da Composição" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudSelect T="string" @bind-Value="_form.TracionantePlaca" Label="Tracionante (cavalo)" Variant="Variant.Outlined" Required="true">
                    @foreach (var v in _tracionantes)
                    {
                        <MudSelectItem Value="@v.Placa">@v.Placa — @v.Marca @v.Modelo</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-1" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.overline" Style="color:#6B7280;font-size:10px;letter-spacing:1px;">REBOQUES (máx 3)</MudText>
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddReboque"
                               Disabled="@(_form.Reboques.Count >= 3)">Adicionar Reboque</MudButton>
                </MudStack>
            </MudItem>

            @for (int i = 0; i < _form.Reboques.Count; i++)
            {
                var idx = i;
                var reb = _form.Reboques[idx];
                <MudItem xs="9" md="9">
                    <MudSelect T="string" @bind-Value="reb.Placa" Label="@($"Reboque {idx + 1}")" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var v in _reboques)
                        {
                            <MudSelectItem Value="@v.Placa">@v.Placa — @v.Marca @v.Modelo</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="2" md="2">
                    <MudNumericField T="int" @bind-Value="reb.Ordem" Label="Ordem" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="3" />
                </MudItem>
                <MudItem xs="1" md="1" Class="d-flex align-center">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => _form.Reboques.RemoveAt(idx))" />
                </MudItem>
            }

            <MudItem xs="12">
                <MudTextField @bind-Value="_form.FavorecidoTitularDocumento" Label="Doc. Favorecido Titular (opcional)" Variant="Variant.Outlined" />
            </MudItem>

            @if (_erro is not null)
            {
                <MudItem xs="12"><MudAlert Severity="Severity.Error" Dense="true">@_erro</MudAlert></MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Salvar" Disabled="_salvando">@(IsEdicao ? "Atualizar" : "Cadastrar")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ComposicaoListItem? Original { get; set; }

    private bool IsEdicao => Original is not null;
    private ComposicaoListItem _form = new();
    private IReadOnlyList<VeiculoListItem> _tracionantes = [];
    private IReadOnlyList<VeiculoListItem> _reboques = [];
    private string? _erro;
    private bool _salvando;

    protected override async Task OnInitializedAsync()
    {
        _form = Original is null
            ? new ComposicaoListItem()
            : new ComposicaoListItem
            {
                Id = Original.Id, Nome = Original.Nome,
                TracionantePlaca = Original.TracionantePlaca,
                FavorecidoTitularDocumento = Original.FavorecidoTitularDocumento,
                Reboques = Original.Reboques.Select(r => new ReboqueItem { Placa = r.Placa, Ordem = r.Ordem }).ToList(),
            };

        _tracionantes = await VeiculoService.ListarAsync(tipoTracao: 1);
        _reboques     = await VeiculoService.ListarAsync(tipoTracao: 2);
    }

    private void AddReboque()
        => _form.Reboques.Add(new ReboqueItem { Ordem = _form.Reboques.Count + 1 });

    private async Task Salvar()
    {
        _erro = null;
        if (string.IsNullOrWhiteSpace(_form.Nome)) { _erro = "Nome obrigatório."; return; }
        if (string.IsNullOrWhiteSpace(_form.TracionantePlaca)) { _erro = "Selecione o tracionante."; return; }
        if (_form.Reboques.Any(r => string.IsNullOrWhiteSpace(r.Placa))) { _erro = "Todos os reboques precisam de placa."; return; }
        if (_form.Reboques.Select(r => r.Ordem).Distinct().Count() != _form.Reboques.Count) { _erro = "Ordem de reboque duplicada."; return; }

        _salvando = true;
        try
        {
            await Service.SalvarAsync(_form);
            Snackbar.Add($"Composição {(IsEdicao ? "atualizada" : "cadastrada")}.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_form));
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }

    private void Cancelar() => MudDialog.Cancel();
}
