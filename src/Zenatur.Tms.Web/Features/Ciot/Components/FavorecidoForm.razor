@using Zenatur.Tms.Application.Favorecidos
@inject IFavorecidoManagementService Service
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(IsEdicao ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" />
            <MudText Typo="Typo.h6">@(IsEdicao ? "Editar Favorecido" : "Novo Favorecido")</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_form.DocumentoTipo"
                           Label="Tipo Doc" Variant="Variant.Outlined">
                    <MudSelectItem Value="1">CPF</MudSelectItem>
                    <MudSelectItem Value="2">CNPJ</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_documento"
                              Label="@(_form.DocumentoTipo == 1 ? "CPF" : "CNPJ")"
                              Variant="Variant.Outlined"
                              Disabled="IsEdicao"
                              Required="true"
                              Immediate="true" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Nome"
                              Label="Nome Completo"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_form.Rntrc"
                              Label="RNTRC"
                              Variant="Variant.Outlined"
                              HelperText="Cadastro ANTT"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_form.RntrcSituacao"
                           Label="Situação RNTRC" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Ativo")">Ativo</MudSelectItem>
                    <MudSelectItem Value="@("Inativo")">Inativo</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_form.Email"
                              Label="E-mail"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email" />
            </MudItem>

            <MudItem xs="6" md="2">
                <MudTextField @bind-Value="_form.TelefoneDdd"
                              Label="DDD"
                              Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="6" md="4">
                <MudTextField @bind-Value="_form.TelefoneNumero"
                              Label="Telefone"
                              Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.overline" Style="color:#6B7280; font-size:10px; letter-spacing:1px;">
                        CONTAS BANCÁRIAS
                    </MudText>
                    <MudButton Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AdicionarConta">
                        Adicionar Conta
                    </MudButton>
                </MudStack>
            </MudItem>

            @for (int i = 0; i < _form.Contas.Count; i++)
            {
                var idx = i;
                var conta = _form.Contas[idx];
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-3" Style="background:#F9FAFB; border:1px solid #E5E7EB; border-radius:8px;">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="conta.Banco"
                                              T="string"
                                              Label="Banco" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField @bind-Value="conta.Agencia"
                                              T="string"
                                              Label="Agência" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="conta.Conta"
                                              T="string"
                                              Label="Conta" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="8" md="2">
                                <MudSelect @bind-Value="conta.Tipo"
                                           T="string"
                                           Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@("CC")">Corrente</MudSelectItem>
                                    <MudSelectItem Value="@("CP")">Poupança</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="4" md="1" Class="d-flex align-center justify-center">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => _form.Contas.RemoveAt(idx))" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }

            @if (_form.Contas.Count == 0)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Nenhuma conta cadastrada. Clique em "Adicionar Conta" para incluir dados bancários.
                    </MudAlert>
                </MudItem>
            }

            @if (_erro is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">@_erro</MudAlert>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Salvar"
                   Disabled="_salvando">
            @(IsEdicao ? "Atualizar" : "Cadastrar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public FavorecidoListItem? Original { get; set; }

    private bool IsEdicao => Original is not null;

    private FavorecidoListItem _form  = new();
    private string             _documento = string.Empty;
    private string?            _erro;
    private bool               _salvando;

    protected override void OnInitialized()
    {
        if (Original is not null)
        {
            _form = Original.Clone();
            _documento = Original.Documento;
        }
        else
        {
            _form = new FavorecidoListItem { DocumentoTipo = 1, RntrcSituacao = "Ativo" };
        }
    }

    private void AdicionarConta()
    {
        _form.Contas.Add(new ContaBancariaItem { Tipo = "CC" });
    }

    private async Task Salvar()
    {
        _erro = null;
        var docLimpo = new string(_documento.Where(char.IsLetterOrDigit).ToArray());

        if (_form.DocumentoTipo == 1 && docLimpo.Length != 11)
        { _erro = "CPF inválido — exige 11 dígitos."; return; }
        if (_form.DocumentoTipo == 2 && docLimpo.Length != 14)
        { _erro = "CNPJ inválido — exige 14 dígitos."; return; }
        if (string.IsNullOrWhiteSpace(_form.Nome))
        { _erro = "Nome é obrigatório."; return; }
        if (string.IsNullOrWhiteSpace(_form.Rntrc))
        { _erro = "RNTRC é obrigatório."; return; }

        _salvando = true;
        try
        {
            _form.Documento = docLimpo;
            var salvo = await Service.SalvarAsync(_form);
            Snackbar.Add($"Favorecido {(IsEdicao ? "atualizado" : "cadastrado")} com sucesso!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(salvo));
        }
        catch (Exception ex)
        {
            _erro = $"Erro ao salvar: {ex.Message}";
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
