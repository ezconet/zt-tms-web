@using Zenatur.Tms.Application.Favorecidos
@using Zenatur.Tms.Application.Domain
@using Zenatur.Tms.Application.Motoristas
@inject IFavorecidoManagementService Service
@inject IMotoristaManagementService MotoristaService
@inject IDomainService DomainService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(IsEdicao ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" />
            <MudText Typo="Typo.h6">@(IsEdicao ? "Editar Favorecido" : "Novo Favorecido")</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_form.DocumentoTipo"
                           Label="Tipo Doc" Variant="Variant.Outlined">
                    <MudSelectItem Value="1">CPF</MudSelectItem>
                    <MudSelectItem Value="2">CNPJ</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_documento"
                              Label="@(_form.DocumentoTipo == 1 ? "CPF" : "CNPJ")"
                              Variant="Variant.Outlined"
                              Disabled="IsEdicao"
                              Required="true"
                              Immediate="true" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Nome"
                              Label="Nome Completo"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>

            @if (_form.DocumentoTipo == 1 && !IsEdicao)
            {
                <MudItem xs="12">
                    <MudCheckBox T="bool" @bind-Value="_tambemMotorista"
                                 Label="Cadastrar também como Motorista (mesmo CPF)"
                                 Color="Color.Primary" Dense="true" />
                </MudItem>
                @if (_tambemMotorista)
                {
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_cnhNumero"
                                      Label="CNH Número (opcional)"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_cnhCategoria"
                                      Label="CNH Categoria (opcional)"
                                      Variant="Variant.Outlined"
                                      HelperText="A, B, C, D, E" />
                    </MudItem>
                }
            }

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_form.Rntrc"
                              Label="RNTRC"
                              Variant="Variant.Outlined"
                              HelperText="Cadastro ANTT"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_form.RntrcSituacao"
                           Label="Situação RNTRC" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Ativo")">Ativo</MudSelectItem>
                    <MudSelectItem Value="@("Inativo")">Inativo</MudSelectItem>
                </MudSelect>
            </MudItem>

            @if (_form.DocumentoTipo == 1)
            {
                <MudItem xs="8" md="3">
                    <MudTextField @bind-Value="_form.RgNumero"
                                  Label="RG"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  HelperText="Obrigatório PF (Pamcard)" />
                </MudItem>
                <MudItem xs="4" md="2">
                    <MudSelect T="string" @bind-Value="_form.RgUf" Label="UF RG" Variant="Variant.Outlined">
                        @foreach (var uf in _ufs)
                        {
                            <MudSelectItem Value="@uf">@uf</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }

            <MudItem xs="12" md="@(_form.DocumentoTipo == 1 ? 4 : 6)">
                <MudTextField @bind-Value="_form.Email"
                              Label="E-mail"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudStack Row="true" Spacing="2">
                    <MudTextField @bind-Value="_form.TelefoneDdd"
                                  Label="DDD"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Style="max-width:90px;"
                                  HelperText="2-3 díg" />
                    <MudTextField @bind-Value="_form.TelefoneNumero"
                                  Label="Telefone"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  HelperText="8-9 díg" />
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_dataNascimento"
                               Label="Data de Nascimento/Constituição"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy"
                               Editable="true"
                               MaxDate="DateTime.Today"
                               Required="true"
                               HelperText="Digite dd/MM/aaaa" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.overline" Style="color:#6B7280; font-size:10px; letter-spacing:1px;">
                    ENDEREÇO
                </MudText>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_form.EnderecoLogradouro"
                              Label="Logradouro"
                              Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="6" md="2">
                <MudTextField @bind-Value="_form.EnderecoNumero"
                              Label="Número"
                              Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="6" md="2">
                <MudTextField @bind-Value="_form.EnderecoCep"
                              Label="CEP"
                              Variant="Variant.Outlined"
                              Required="true"
                              HelperText="Obrigatório (Pamcard)" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_form.EnderecoBairro"
                              Label="Bairro"
                              Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudAutocomplete T="CidadeIbgeItem"
                                 Value="_cidadeSelecionada"
                                 ValueChanged="OnCidadeChanged"
                                 SearchFunc="BuscarCidades"
                                 ToStringFunc="@(c => c?.Descricao ?? string.Empty)"
                                 Label="Cidade"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 MinCharacters="1"
                                 DebounceInterval="200"
                                 HelperText="Digite — IBGE + UF preenchem sozinhos" />
            </MudItem>

            <MudItem xs="6" md="4">
                <MudTextField @bind-Value="_form.EnderecoCidadeIbge"
                              Label="Código IBGE"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              HelperText="Automático" />
            </MudItem>

            <MudItem xs="6" md="2">
                <MudSelect T="string" @bind-Value="_form.EnderecoUf"
                           Label="UF" Variant="Variant.Outlined">
                    @foreach (var uf in _ufs)
                    {
                        <MudSelectItem Value="@uf">@uf</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.overline" Style="color:#6B7280; font-size:10px; letter-spacing:1px;">
                        CONTAS BANCÁRIAS
                    </MudText>
                    <MudButton Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AdicionarConta">
                        Adicionar Conta
                    </MudButton>
                </MudStack>
            </MudItem>

            @for (int i = 0; i < _form.Contas.Count; i++)
            {
                var idx = i;
                var conta = _form.Contas[idx];
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-3" Style="background:#F9FAFB; border:1px solid #E5E7EB; border-radius:8px;">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="conta.Banco"
                                              T="string"
                                              Label="Banco" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField @bind-Value="conta.Agencia"
                                              T="string"
                                              Label="Agência" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="conta.Conta"
                                              T="string"
                                              Label="Conta" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="8" md="2">
                                <MudSelect @bind-Value="conta.Tipo"
                                           T="string"
                                           Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@("CC")">Corrente</MudSelectItem>
                                    <MudSelectItem Value="@("CP")">Poupança</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="4" md="1" Class="d-flex align-center justify-center">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => _form.Contas.RemoveAt(idx))" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }

            @if (_form.Contas.Count == 0)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Nenhuma conta cadastrada. Clique em "Adicionar Conta" para incluir dados bancários.
                    </MudAlert>
                </MudItem>
            }

            @if (_erro is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">@_erro</MudAlert>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@(_salvando ? null : Icons.Material.Filled.Save)"
                   OnClick="Salvar"
                   Disabled="_salvando">
            @if (_salvando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Salvando...</span>
            }
            else
            {
                <span>@(IsEdicao ? "Atualizar" : "Cadastrar")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public FavorecidoListItem? Original { get; set; }
    [Parameter] public string? DocumentoPreenchido { get; set; }
    [Parameter] public int?    DocumentoTipoPreenchido { get; set; }

    private bool IsEdicao => Original is not null;

    private FavorecidoListItem _form  = new();
    private string             _documento = string.Empty;
    private DateTime?          _dataNascimento;
    private string?            _erro;
    private bool               _salvando;
    private bool               _tambemMotorista = true;
    private string?            _cnhNumero;
    private string?            _cnhCategoria;
    private CidadeIbgeItem?    _cidadeSelecionada;
    private IReadOnlyList<CidadeIbgeItem> _cidades = [];

    private static readonly string[] _ufs =
    [
        "AC","AL","AP","AM","BA","CE","DF","ES","GO","MA","MT","MS","MG",
        "PA","PB","PR","PE","PI","RJ","RN","RS","RO","RR","SC","SP","SE","TO"
    ];

    protected override async Task OnInitializedAsync()
    {
        if (Original is not null)
        {
            _form = Original.Clone();
            _documento = Original.Documento;
        }
        else
        {
            _form = new FavorecidoListItem
            {
                DocumentoTipo = DocumentoTipoPreenchido ?? 1,
                RntrcSituacao = "Ativo",
                Documento     = DocumentoPreenchido ?? string.Empty,
            };
            _documento = DocumentoPreenchido ?? string.Empty;
        }
        if (_form.DataNascimento is DateOnly dn) _dataNascimento = dn.ToDateTime(TimeOnly.MinValue);

        _cidades = await DomainService.GetCidadesAsync();
        if (!string.IsNullOrEmpty(_form.EnderecoCidadeIbge))
            _cidadeSelecionada = _cidades.FirstOrDefault(c => c.Ibge == _form.EnderecoCidadeIbge);
    }

    private static string RemoverAcentos(string s)
    {
        var norm = s.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(norm.Length);
        foreach (var ch in norm)
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(ch);
        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC);
    }

    private Task<IEnumerable<CidadeIbgeItem>> BuscarCidades(string? termo, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(termo))
            return Task.FromResult(Enumerable.Empty<CidadeIbgeItem>());
        var t = RemoverAcentos(termo.Trim()).ToLowerInvariant();
        return Task.FromResult(_cidades
            .Where(c => RemoverAcentos(c.Cidade).Contains(t, StringComparison.OrdinalIgnoreCase)
                     || c.Uf.Equals(termo.Trim(), StringComparison.OrdinalIgnoreCase))
            .Take(50));
    }

    private void OnCidadeChanged(CidadeIbgeItem? c)
    {
        _cidadeSelecionada = c;
        if (c is null) return;
        _form.EnderecoCidadeIbge = c.Ibge;
        _form.EnderecoUf         = c.Uf;
    }

    private void AdicionarConta()
    {
        _form.Contas.Add(new ContaBancariaItem { Tipo = "CC" });
    }

    private async Task Salvar()
    {
        _erro = null;
        var docLimpo = new string(_documento.Where(char.IsLetterOrDigit).ToArray());

        if (_form.DocumentoTipo == 1 && docLimpo.Length != 11)
        { _erro = "CPF inválido — exige 11 dígitos."; return; }
        if (_form.DocumentoTipo == 2 && docLimpo.Length != 14)
        { _erro = "CNPJ inválido — exige 14 dígitos."; return; }
        if (string.IsNullOrWhiteSpace(_form.Nome))
        { _erro = "Nome é obrigatório."; return; }
        if (string.IsNullOrWhiteSpace(_form.Rntrc))
        { _erro = "RNTRC é obrigatório."; return; }
        if (string.IsNullOrWhiteSpace(_form.TelefoneDdd) || string.IsNullOrWhiteSpace(_form.TelefoneNumero))
        { _erro = "Telefone é obrigatório."; return; }
        if (_dataNascimento is null)
        { _erro = "Data de Nascimento/Constituição é obrigatória."; return; }
        if (string.IsNullOrWhiteSpace(_form.EnderecoCep))
        { _erro = "CEP é obrigatório (exigido pela Pamcard)."; return; }
        if (string.IsNullOrWhiteSpace(_form.EnderecoCidadeIbge))
        { _erro = "Selecione a Cidade."; return; }
        if (_form.DocumentoTipo == 1 && string.IsNullOrWhiteSpace(_form.RgNumero))
        { _erro = "RG é obrigatório para Pessoa Física (exigido pela Pamcard)."; return; }

        _form.DataNascimento = DateOnly.FromDateTime(_dataNascimento.Value);

        _salvando = true;
        try
        {
            _form.Documento = docLimpo;
            var salvo = await Service.SalvarAsync(_form);

            // PF + opção marcada → espelha cadastro na base de Motorista (mesmo CPF)
            if (_tambemMotorista && _form.DocumentoTipo == 1 && !IsEdicao && docLimpo.Length == 11)
            {
                try
                {
                    await MotoristaService.SalvarAsync(new MotoristaListItem
                    {
                        Cpf            = docLimpo,
                        Nome           = _form.Nome,
                        DataNascimento = _form.DataNascimento,
                        Email          = _form.Email,
                        Rntrc          = _form.Rntrc,
                        RntrcSituacao  = _form.RntrcSituacao,
                        TelefoneDdd    = _form.TelefoneDdd,
                        TelefoneNumero = _form.TelefoneNumero,
                        CnhNumero      = _cnhNumero,
                        CnhCategoria   = _cnhCategoria,
                        Logradouro         = _form.EnderecoLogradouro,
                        EnderecoNumero     = int.TryParse(_form.EnderecoNumero, out var en) ? en : (int?)null,
                        Bairro             = _form.EnderecoBairro,
                        EnderecoCidadeIbge = _form.EnderecoCidadeIbge,
                        EnderecoUf         = _form.EnderecoUf,
                        Cep                = _form.EnderecoCep,
                    });
                    Snackbar.Add("Favorecido + Motorista cadastrados.", Severity.Success);
                }
                catch (Exception exM)
                {
                    Snackbar.Add($"Favorecido OK, mas motorista falhou: {exM.Message}", Severity.Warning);
                }
            }
            else
            {
                Snackbar.Add($"Favorecido {(IsEdicao ? "atualizado" : "cadastrado")} com sucesso!", Severity.Success);
            }
            MudDialog.Close(DialogResult.Ok(salvo));
        }
        catch (Exception ex)
        {
            _erro = $"Erro ao salvar: {ex.Message}";
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
