@page "/ciot/favorecidos"
@rendermode InteractiveServer
@using Zenatur.Tms.Application.Favorecidos
@using Zenatur.Tms.Web.Features.Ciot.Components
@inject IFavorecidoManagementService Service
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<PageTitle>Favorecidos</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-5" />

<MudCard Elevation="1" Style="border-radius:12px; overflow:hidden;">
    <div class="zt-card-header">
        <span style="display:flex; align-items:center; gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
            Favorecidos
        </span>
        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="AbrirNovo"
                   Style="border-color:rgba(0,0,0,0.2); color:#1f2937; font-size:12px;">
            Novo Favorecido
        </MudButton>
    </div>
    <MudCardContent Class="pa-0">

        <div class="pa-4" style="border-bottom:1px solid #F3F4F6;">
            <MudTextField @bind-Value="_termoBusca" @bind-Value:after="Filtrar"
                          Placeholder="Buscar por nome, CPF/CNPJ ou RNTRC..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="false" />
        </div>

        @if (_carregando)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (_favorecidos.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="ma-4">
                Nenhum favorecido encontrado.
            </MudAlert>
        }
        else
        {
            <MudTable Items="_favorecidos" Dense="true" Hover="true" Elevation="0"
                      RowStyle="font-size:13px;">
                <HeaderContent>
                    <MudTh>Nome</MudTh>
                    <MudTh>Documento</MudTh>
                    <MudTh>RNTRC</MudTh>
                    <MudTh>Contato</MudTh>
                    <MudTh>Contas</MudTh>
                    <MudTh>Situação</MudTh>
                    <MudTh Style="text-align:right;">Ações</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><strong>@context.Nome</strong></MudTd>
                    <MudTd>
                        <MudText Typo="Typo.caption" Style="font-family:monospace; color:#6B7280;">
                            @FormatarDoc(context.Documento, context.DocumentoTipo)
                        </MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.caption" Style="font-family:monospace;">@context.Rntrc</MudText>
                    </MudTd>
                    <MudTd>
                        <MudStack Spacing="0">
                            @if (!string.IsNullOrEmpty(context.Email))
                            {
                                <MudText Typo="Typo.caption">@context.Email</MudText>
                            }
                            @if (!string.IsNullOrEmpty(context.TelefoneDdd))
                            {
                                <MudText Typo="Typo.caption" Style="color:#6B7280;">(@context.TelefoneDdd) @context.TelefoneNumero</MudText>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Label="true"
                                 Style="background:#EFF6FF; color:#1D4ED8; font-size:11px;">
                            @context.Contas.Count
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Label="true"
                                 Style="@(context.RntrcAtivo
                                     ? "background:#D1FAE5; color:#065F46; font-size:11px;"
                                     : "background:#FEE2E2; color:#991B1B; font-size:11px;")">
                            @context.RntrcSituacao
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align:right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small" Color="Color.Default"
                                       OnClick="() => AbrirEdicao(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small" Color="Color.Error"
                                       OnClick="() => ConfirmarRemocao(context)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudCardContent>
</MudCard>

@code {
    private List<FavorecidoListItem> _favorecidos = [];
    private string _termoBusca = string.Empty;
    private bool _carregando;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Home",        href: "/",                 icon: Icons.Material.Filled.Home),
        new("CIOT",        href: null,                disabled: true),
        new("Favorecidos", href: "/ciot/favorecidos", disabled: false),
    ];

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        try
        {
            var lista = await Service.ListarAsync(_termoBusca);
            _favorecidos = lista.ToList();
        }
        finally
        {
            _carregando = false;
        }
    }

    private Task Filtrar() => CarregarAsync();

    private async Task AbrirNovo()
    {
        var dialog = await Dialog.ShowAsync<FavorecidoForm>("Novo Favorecido",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await CarregarAsync();
    }

    private async Task AbrirEdicao(FavorecidoListItem fav)
    {
        var parameters = new DialogParameters { ["Original"] = fav };
        var dialog = await Dialog.ShowAsync<FavorecidoForm>("Editar Favorecido", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await CarregarAsync();
    }

    private async Task ConfirmarRemocao(FavorecidoListItem fav)
    {
        var ok = await Dialog.ShowMessageBoxAsync(
            title:      "Confirmar remoção",
            message:    $"Remover favorecido {fav.Nome}?",
            yesText:    "Remover",
            noText:     null,
            cancelText: "Cancelar",
            options:    null);
        if (ok != true) return;

        var removed = await Service.RemoverAsync(fav.Documento);
        if (removed)
        {
            Snackbar.Add("Favorecido removido.", Severity.Success);
            await CarregarAsync();
        }
        else
        {
            Snackbar.Add("Falha ao remover.", Severity.Error);
        }
    }

    private static string FormatarDoc(string doc, int tipo) =>
        tipo == 1 && doc.Length == 11
            ? $"{doc[..3]}.{doc[3..6]}.{doc[6..9]}-{doc[9..]}"
            : tipo == 2 && doc.Length == 14
                ? $"{doc[..2]}.{doc[2..5]}.{doc[5..8]}/{doc[8..12]}-{doc[12..]}"
                : doc;
}
